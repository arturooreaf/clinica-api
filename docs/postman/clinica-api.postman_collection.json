{
  "info": {
    "name": "Clinica API",
    "description": "Test collection for the patients and appointments API.\n\nHOW TO USE IT\n1. Start the API: docker compose up -d && npm run dev\n2. Run 'Auth > Login'. Its script saves the token automatically.\n3. Every other request already uses it: nothing to copy.\n\nThe token expires after one hour: if you start getting 401s, run Login again.\n\nThe 'Patients > Delete' request deletes patient 1, so the second time\nit returns 404. That is expected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "The API is up",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Public route. It only confirms that the server is alive."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responds 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo3@example.com\",\n  \"password\": \"Example123\",\n  \"name\": \"Demo User Three\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 with id, email and name. No password_hash: UserView guarantees that.\n409 'Email is already registered' if the email already exists."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"Example123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns the JWT and saves it in the {{token}} variable.\nTakes ~90 ms because of bcrypt; the other requests take 1-9 ms."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responds 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Save the token in a collection variable",
                  "// so every other request uses it on its own.",
                  "const body = pm.response.json();",
                  "",
                  "if (body.token) {",
                  "  pm.collectionVariables.set(\"token\", body.token);",
                  "  console.log(\"Token saved\");",
                  "} else {",
                  "  console.warn(\"The response had no token\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"WrongPassword1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "401 'Invalid credentials'. Same message as when the email does not exist,\nto prevent user enumeration."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responds 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
