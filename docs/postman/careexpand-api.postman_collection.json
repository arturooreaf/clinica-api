          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "1"
              ]
            },
            "description": "204 sin cuerpo. Al borrar un paciente se borran sus citas (ON DELETE CASCADE)."
          }
        },
        {
          "name": "Crear con datos invalidos",
          "request": {
